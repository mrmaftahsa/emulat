<Window x:Class="DeviceLab.CreateDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="New virtual device" Width="490" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22">
        <TextBlock Text="New virtual device" Style="{StaticResource Heading}"/>
        <TextBlock x:Name="DeviceSummary" Style="{StaticResource Hint}" Margin="0,6,0,12"/>
        <Expander Header="Customize device" Margin="0,0,0,17">
            <StackPanel Margin="0,10,0,0">
                <Label Content="_Device name" Target="{Binding ElementName=DeviceNameBox}" Padding="0,0,0,5"/>
                <TextBox x:Name="DeviceNameBox" MaxLength="64" AutomationProperties.Name="Device name"
                         TextChanged="DetailsChanged" Margin="0,0,0,13"/>
                <Label Content="_Android version" Target="{Binding ElementName=ImageBox}" Padding="0,0,0,5"/>
                <ComboBox x:Name="ImageBox" DisplayMemberPath="DisplayName" AutomationProperties.Name="Android version"
                          SelectionChanged="DetailsChanged"/>
            </StackPanel>
        </Expander>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="CreateButton" Content="_Create and start" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="CreateClicked"/>
        </StackPanel>
    </StackPanel>
</Window>
