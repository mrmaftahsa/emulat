<Window x:Class="DeviceLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="Device Lab" Height="810" Width="1120" MinHeight="610" MinWidth="860"
        WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closed="WindowClosed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Header}" Padding="25,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Device Lab" Foreground="White" FontSize="21" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,34,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="DevicesNav" Style="{StaticResource Navigation}"
                                 GroupName="Workspace" Content="Devices" IsChecked="True"
                                 Checked="NavigationChanged" Margin="0,0,6,0"/>
                    <RadioButton x:Name="SetupNav" Style="{StaticResource Navigation}"
                                 GroupName="Workspace" Content="Setup" Checked="NavigationChanged"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Emulator" Foreground="{StaticResource HeaderMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="EmulatorChoice" Width="146" AutomationProperties.Name="Emulator"
                              SelectionChanged="EmulatorChoiceChanged">
                        <ComboBoxItem Content="MEmu"/>
                        <ComboBoxItem Content="Android SDK"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="DevicePage" Grid.Row="1" Margin="25,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="True" Margin="0,0,0,17">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="_Refresh" Click="RefreshClicked" Margin="0,0,8,0"/>
                    <Button x:Name="NewButton" Content="_New device" Style="{StaticResource PrimaryButton}" Click="NewDeviceClicked"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Virtual devices" Style="{StaticResource Title}"/>
                    <TextBlock x:Name="DeviceCount" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <Grid x:Name="DeviceEditor" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid Margin="12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="3,2,3,10">
                            <Label Content="_Filter" Target="{Binding ElementName=SearchBox}" VerticalAlignment="Center"
                                   Padding="0,0,8,0"/>
                            <TextBox x:Name="SearchBox" AutomationProperties.Name="Filter devices" TextChanged="SearchChanged"/>
                        </DockPanel>
                        <ListBox x:Name="DevicesList" Grid.Row="1" BorderThickness="0" Padding="0"
                                 AutomationProperties.Name="Virtual devices"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="DeviceSelected">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocus}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Frame" CornerRadius="7" Background="Transparent"
                                                        BorderBrush="Transparent" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Frame" Property="Background" Value="{StaticResource Canvas}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Frame" Property="Background" Value="{StaticResource Tint}"/>
                                                        <Setter TargetName="Frame" Property="BorderBrush" Value="#A5CFC6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="12,10">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="13"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyList" Grid.Row="1" Margin="12,10" Style="{StaticResource Hint}"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Border x:Name="EmptyDetail" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="370">
                        <TextBlock x:Name="EmptyTitle" Text="Select a device" Style="{StaticResource Heading}" TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,0"/>
                        <Button x:Name="OpenSetupButton" Content="Open setup" HorizontalAlignment="Center"
                                Style="{StaticResource PrimaryButton}" Margin="0,15,0,0" Click="OpenSetupClicked"/>
                        <Button x:Name="CreateFirstButton" Content="Create your first device" HorizontalAlignment="Center"
                                Style="{StaticResource PrimaryButton}" Margin="0,15,0,0" Click="NewDeviceClicked"/>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="DeviceDetails" Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="SelectedName" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SelectedStatus" Style="{StaticResource Hint}" Margin="0,4,0,14"/>
                                <WrapPanel>
                                    <Button x:Name="StartButton" Content="_Start" Style="{StaticResource PrimaryButton}"
                                            Click="StartClicked" Margin="0,0,8,4"/>
                                    <Button x:Name="StopButton" Content="S_top" Click="StopClicked" Margin="0,0,8,4"/>
                                    <Button x:Name="InstallButton" Content="_Install APK…" Click="InstallClicked" Margin="0,0,8,4"/>
                                </WrapPanel>
                                <TextBlock x:Name="LaunchError" Style="{StaticResource Hint}" Foreground="{StaticResource Error}"
                                           Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LocationCard" Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Test location" Style="{StaticResource Heading}"/>
                                <TextBlock Text="Save coordinates for this device and apply them to the running emulator."
                                           Style="{StaticResource Hint}" Margin="0,4,0,11"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="Latit_ude" Target="{Binding ElementName=Latitude}" Padding="0,0,0,5"/>
                                        <TextBox x:Name="Latitude" AutomationProperties.Name="Latitude" MaxLength="32" TextChanged="CoordinatesChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="_Longitude" Target="{Binding ElementName=Longitude}" Padding="0,0,0,5"/>
                                        <TextBox x:Name="Longitude" AutomationProperties.Name="Longitude" MaxLength="32" TextChanged="CoordinatesChanged"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button x:Name="SaveLocationButton" Content="Save location" Click="SaveLocationClicked" Margin="0,0,8,4"/>
                                    <Button x:Name="ApplyLocationButton" Content="Apply to emulator" Click="ApplyLocationClicked" Margin="0,0,0,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="LogsButton" DockPanel.Dock="Right" Content="Read logs" Click="LogsClicked"/>
                                    <TextBlock Text="Device logs" Style="{StaticResource Heading}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                </DockPanel>
                                <TextBlock Text="Read and copy up to 250 recent logcat entries." Style="{StaticResource Hint}"/>
                                <TextBox x:Name="Logs" AutomationProperties.Name="Recent device logs" Visibility="Collapsed"
                                         Margin="0,10,0,0" Height="200" FontFamily="Consolas" FontSize="12"
                                         IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <ScrollViewer x:Name="SetupPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25,23" MaxWidth="1200">
                <TextBlock Text="Setup" Style="{StaticResource Title}" Margin="0,0,0,15"/>
                <Border x:Name="MEmuSetupCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="MEmu setup" Style="{StaticResource Heading}"/>
                        <TextBlock x:Name="MEmuSummary" Style="{StaticResource Hint}" Margin="0,5,0,13"/>
                        <Button x:Name="BrowseMEmuButton" Content="Choose MEmu folder…" Click="BrowseMEmuClicked"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="AndroidSetupSections">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Android setup" Style="{StaticResource Heading}"/>
                            <TextBlock x:Name="SetupSummary" Text="Checking the Android components on this PC…"
                                       Style="{StaticResource Hint}" Margin="0,5,0,13"/>
                            <Button x:Name="GuidedSetupButton" Content="Set up Android" Click="GuidedSetupClicked"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="VirtualizationCard" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Windows virtualization" Style="{StaticResource Heading}"/>
                            <TextBlock x:Name="VirtualizationSummary" Style="{StaticResource Hint}" Margin="0,5,0,13"/>
                            <WrapPanel>
                                <Button x:Name="EnableVirtualizationButton" Content="Enable Windows virtualization"
                                        Click="EnableVirtualizationClicked" Style="{StaticResource PrimaryButton}" Margin="0,0,8,5"/>
                                <Button x:Name="CheckVirtualizationButton" Content="Check again" Click="CheckVirtualizationClicked"
                                        Margin="0,0,8,5"/>
                                <Button Content="Virtualization help" Click="VirtualizationHelpClicked" Margin="0,0,0,5"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Expander Header="Advanced settings">
                            <StackPanel Margin="0,13,0,0">
                                <Label Content="_Android SDK folder" Target="{Binding ElementName=SdkPath}" FontWeight="SemiBold" Padding="0,0,0,7"/>
                                <DockPanel>
                                    <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="_Browse…" Click="BrowseClicked" Margin="8,0,0,0"/>
                                    <TextBox x:Name="SdkPath" AutomationProperties.Name="Android SDK folder" TextChanged="SdkPathChanged"/>
                                </DockPanel>
                                <TextBlock Text="Change this folder if you want Device Lab to use a different Android SDK."
                                           Style="{StaticResource Hint}" Margin="0,8,0,13"/>
                                <Button x:Name="DiagnosticsButton" Content="Save and run _diagnostics" Click="DiagnosticsClicked"
                                        HorizontalAlignment="Left"/>
                                <TextBlock x:Name="DiagnosticsHint" Style="{StaticResource Hint}" Margin="0,13,0,0"/>
                                <ItemsControl x:Name="DiagnosticsList" Margin="0,9,0,0" AutomationProperties.Name="Environment checks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="164"/>
                                                        <ColumnDefinition Width="74"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Check}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Hint}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="25,9" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar x:Name="WorkProgress" DockPanel.Dock="Right" Width="76" Height="4"
                             Foreground="{StaticResource Accent}" IsIndeterminate="True" Visibility="Collapsed"
                             Margin="14,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusMessage" Style="{StaticResource Hint}" FontSize="13"
                           AutomationProperties.LiveSetting="Polite" MaxHeight="62" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
