<Window x:Class="DeviceLab.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="Set up Android" Width="620" SizeToContent="Height"
        MaxHeight="750" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Closing="WindowClosing">
    <StackPanel Margin="26">
        <TextBlock x:Name="PageTitle" Text="Set up Android" Style="{StaticResource Title}"/>
        <TextBlock x:Name="Intro" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
        <StackPanel x:Name="LicensePanel" Visibility="Collapsed">
            <TextBox x:Name="Terms" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     Height="226" Margin="0,12,0,10" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Google Android SDK license agreement"/>
            <CheckBox x:Name="Agree" Content="I accept Google’s Android SDK terms."
                      Checked="AgreementChanged" Unchecked="AgreementChanged"/>
        </StackPanel>

        <ProgressBar x:Name="SetupProgressBar" Height="7" Margin="0,16,0,0" Visibility="Collapsed"
                     Foreground="{StaticResource Accent}" AutomationProperties.Name="Setup progress"/>
        <TextBlock x:Name="SetupMessage" Style="{StaticResource Hint}" Visibility="Collapsed"
                   Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Close" Click="CancelClicked" Margin="0,0,8,0"/>
            <Button x:Name="NextButton" Content="_Next" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="NextClicked"/>
        </StackPanel>
    </StackPanel>
</Window>
